{
 "multipart": [
  {
   "when": {
    "OR": [
     {
      "north": "true"
     },
     {
      "south": "true"
     }
    ]
   },
   "apply": {
    "model": "stagelite:block/truss_tube"
   }
  },
  {
   "when": {
    "OR": [
     {
      "east": "true"
     },
     {
      "west": "true"
     }
    ]
   },
   "apply": {
    "model": "stagelite:block/truss_tube",
    "y": 90
   }
  },
  {
   "when": {
    "OR": [
     {
      "up": "true"
     },
     {
      "down": "true"
     }
    ]
   },
   "apply": {
    "model": "stagelite:block/truss_tube",
    "x": 90
   }
  },
  {
   "when": {
    "north": "false",
    "south": "false",
    "east": "false",
    "west": "false",
    "up": "false",
    "down": "false"
   },
   "apply": {
    "model": "stagelite:block/truss_tube",
    "x": 90
   }
  }
 ]
}